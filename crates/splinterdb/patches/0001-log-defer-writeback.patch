 platform_status
+writeback_set_defer_page(writeback_set *set, uint64 addr, page_type type)
+{
+   platform_status rc = writeback_set_reserve_one(set);
+   if (!SUCCESS(rc)) {
+      return rc;
+   }
+
+   /*
+    * Nothing issued yet (gen 0 reads as complete): needs_retry makes the next
+    * writeback_set_retry_incomplete() submit it before any wait relies on it.
+    */
+   writeback_set_entry entry = {
+      .request     = {.addr = addr, .gen = 0, .is_extent = FALSE},
+      .type        = type,
+      .needs_retry = TRUE,
+   };
+   rc = vector_append(&set->entries, entry);
+   platform_assert_status_ok(rc); // reserved above
+   return STATUS_OK;
+}
